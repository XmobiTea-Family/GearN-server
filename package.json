    "dev": "npm run build && npm run debug",
    "debug": "node index.js",
    "test": "mocha -r ts-node/register ./test/**/*.test.ts",
    "build": "rm -rf ./dist && webpack --mode production --stats-modules && npm run copyCloudScriptTemplate",
