{
    "name": "@xmobitea/gearn-server",
    "version": "2.6.0",
    "description": "GearN Server by XmobiTea (Pro)",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "scripts": {
        "dev": "npm run build && npm run debug",
        "debug": "node index.js",
        "test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .test-dist/test",
        "build": "rm -rf ./dist && webpack --mode production --stats-modules && npm run copy:cloudScriptTemplate",
        "build:tsc": "rm -rf ./dist && tsc",
        "build:cloudScript": "tsc -p ./src/GN-startup/cloudScript/tsconfig.json",
        "copy:cloudScriptTemplate": "node ./syncCodeVer2.js && cp -R ./src/GN-startup/cloudScript ./dist/GN-startup/cloudScript",
        "push": "npm run build && npm publish && git push"
    },
    "author": "Chang X <changx.develop@gmail.com> (https://xmobitea.com)",
    "license": "Apache-2.0",
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.10.5",
        "@types/nodemailer": "^8.0.0",
        "terser-webpack-plugin": "^5.5.0",
        "ts-loader": "^9.5.7",
        "typescript": "^5.8.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^5.1.4",
        "webpack-node-externals": "^3.0.0"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3",
        "@socket.io/mongo-adapter": "^0.4.0",
        "@socket.io/mongo-emitter": "^0.2.0",
        "@xmobitea/gearn-typescript-client-sdk": "^2.6.3",
        "axios": "^1.15.2",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "express": "^4.22.1",
        "firebase-admin": "^13.9.0",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^3.2.1",
        "log4js": "^6.9.1",
        "mongodb": "^6.21.0",
        "multer": "^2.0.2",
        "nodemailer": "^8.0.7",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.3",
        "systeminformation": "^5.30.5"
    },
    "overrides": {
        "body-parser": "1.20.5",
        "fast-uri": "3.1.2",
        "fast-xml-builder": "1.2.0",
        "protobufjs": "7.6.1",
        "qs": "6.15.2",
        "uuid": "11.1.1",
        "ws": "8.21.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/XmobiTea-Family/GearN-Server.git"
    },
    "keywords": [
        "GN",
        "GearN",
        "Server",
        "Pro",
        "XmobiTea"
    ],
    "bugs": {
        "url": "https://github.com/XmobiTea-Family/GearN-Server/issues"
    },
    "homepage": "https://gearn.net",
    "engines": {
        "node": ">=20.0.0"
    }
}
