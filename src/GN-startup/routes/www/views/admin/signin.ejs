<body class="bg-primary" id="layoutAuthentication">
    <div id="layoutAuthentication_content">
        <main>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-5">
                        <div class="card shadow-lg border-0 rounded-lg mt-5">
                            <div class="card-header"><h3 class="text-center font-weight-light my-4">Sign in to GN dashboard</h3></div>
                            <div class="card-body">
                                <form action="./signin" method="post" id="signinForm">
                                    <% if (locals.messages && messages.errors) { %>
                                        <% if (messages.errors.ReturnCode) { %>
                                            <strong class="invalid-feedback" style="display: block">
                                                ReturnCode: <%= messages.errors.ReturnCode %>
                                            </strong>
                                        <% } %>
                    
                                        <% if (messages.errors.ErrorCode) { %>
                                            <strong class="invalid-feedback" style="display: block">
                                                ErrorCode: <%= messages.errors.ErrorCode %>
                                            </strong>
                                        <% } %>
                                    <% } %>

                                    <div class="form-floating mb-3">
                                        <input class="form-control" id="usernameField" type="text" name="username" />
                                        <label for="usernameField">Username</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input class="form-control" id="passwordField" type="password" name="password"/>
                                        <label for="passwordField">Password</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input class="form-control" id="debugHashField" type="password" name="debugHash" />
                                        <label for="debugHashField">Debug Hash</label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" id="inputRememberPassword" type="checkbox" value="" />
                                        <label class="form-check-label" for="inputRememberPassword">Remember Password</label>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                        <button class="btn btn-primary" type="submit" form="signinForm" onclick="lsRememberMe()">Login</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('./../partials/common/footer'); -%>
</body>

<script src="/admin/signin-common.js"></script>