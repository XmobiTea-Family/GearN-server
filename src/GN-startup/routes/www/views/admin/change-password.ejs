<body class="bg-primary" id="layoutAuthentication">
    <div id="layoutAuthentication_content">
        <main>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-5">
                        <div class="card shadow-lg border-0 rounded-lg mt-5">
                            <div class="card-header"><h3 class="text-center font-weight-light my-4">Change password</h3></div>
                            <div class="card-body">
                                <form action="./change-password" method="post" id="changepasswordForm">
                                    <% if (locals.messages && messages.errors) { %>
                                        <% if (messages.errors.msg) { %>
                                            <strong class="invalid-feedback" style="display: block">
                                                <%= messages.errors.msg %>
                                            </strong>
                                        <% } %>
                                    <% } %>

                                    <div class="form-floating mb-3">
                                        <input class="form-control" id="passwordField" type="password" name="password"/>
                                        <label for="passwordField">Current Password</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input class="form-control" id="passwordField" type="password" name="newpassword"/>
                                        <label for="newpasswordField">New Password</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input class="form-control" id="passwordField" type="password" name="repassword"/>
                                        <label for="repasswordField">Re Enter New Password</label>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                        <button class="btn btn-primary" type="submit" form="changepasswordForm">Change password</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('./../partials/common/footer'); -%>
</body>
