<h1 class="mt-4">
    <% if (locals.data) { %>
        <%= data.name %>@<%= data.version %>
    <% } %>
</h1>
<ol class="breadcrumb mb-1">
    <li class="breadcrumb-item active">
        <% if (locals.data) { %>
            <%= data.description %>
        <% } %>
    </li>
</ol>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">
        <% if (locals.data) { %>
            GNVersion: <%= data.gnVersion %>
        <% } %>
    </li>
</ol>