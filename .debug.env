PORT=2202
USE_SSL=FALSE
KEY_FILE_PATH=
CERT_FILE_PATH=

HTTP_APP_ENABLE=TRUE
HTTP_APP_ALLOW_ORIGIN=*
HTTP_APP_CREDENTIALS=TRUE
HTTP_APP_ALLOW_METHODS=GET
HTTP_APP_ALLOW_HEADERS=a

SOCKET_APP_ENABLE=TRUE
SOCKET_APP_PING_INTERVAL=50000
SOCKET_APP_PING_TIMEOUT=5000

ADAPTER_EVENT_COLLECTION_NAME=AdapterEventCollection
AUTH_INFO_COLLECTION_NAME=AuthInfoCollection
CONFIG_COLLECTION_NAME=ConfigGame
PACKAGE_NAME=com.xmobitea.GNServer

DATABASE_CONNECTION_STRING=mongodb://localhost:27017
DATABASE_NAME=XmobiTea
DATABASE_GAME_NAME=GN.
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=100

MAIL_ENABLE=TRUE
MAIL_SEND_FROM=changx@xmobitea.com
MAIL_SG_API_KEY=SG...